# Backend (copy to backend/.env for local development)
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/queuesaathi_demo
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
# Set CLIENT_ORIGIN only when the frontend is hosted on a different origin.
# Same-origin deployment (the Node server also serves the frontend) does not need CORS.
# CLIENT_ORIGIN=https://your-frontend.example.com
COOKIE_SAME_SITE=lax

# Required only when running npm run seed:demo. Choose private local passwords (12+ chars).
DEMO_ADMIN_EMAIL=admin@queuesaathi.test
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_EMAIL=staff@queuesaathi.test
DEMO_STAFF_PASSWORD=

# One-time production admin bootstrap; use only when you run `npm run admin:create`.
BOOTSTRAP_ADMIN_NAME=QueueSaathi Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Frontend build. /api is the default and works for the included same-origin deployment.
# For a separately hosted frontend, set VITE_API_URL to https://your-api.example.com/api
# in the frontend build environment.
# VITE_API_URL=/api
